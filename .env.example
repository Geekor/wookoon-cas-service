# 服务配置
SERVER_PORT=8080
# debug release test
SERVER_MODE=debug

# Casdoor 配置
CASDOOR_ENDPOINT=https://door.casdoor.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_ORGANIZATION=your_organization
CASDOOR_APPLICATION=your_application
CASDOOR_CERTIFICATE_FILE=./certs/casdoor.pem

# 业务 JWT 配置
JWT_SECRET=your-super-secret-key-at-least-32-characters
JWT_EXPIRE_HOURS=24
JWT_ISSUER=my-org-auth-service

# CORS 允许的前端域名（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000